Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Metric grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Color: 90; 90; 90
      Alpha: 0.35
    - Class: rviz/Map
      Name: Orchard occupancy map
      Enabled: true
      Topic: /map
      Alpha: 0.75
      Color Scheme: map
    - Class: rviz/MarkerArray
      Name: Zones and topological graph
      Enabled: true
      Marker Topic: /orchard_map_markers
    - Class: rviz/RobotModel
      Name: Robot A
      Enabled: true
      Robot Description: /robot/robot_description
      TF Prefix: ""
    - Class: rviz/RobotModel
      Name: Robot B
      Enabled: true
      Robot Description: /robot_b/robot_description
      TF Prefix: ""
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top view
      Scale: 45
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 900
